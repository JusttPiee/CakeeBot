# Optional reference. You do NOT need to copy this: on first run the bot asks
# for the required values and saves them to .env for you.
# Never commit the real .env file.

# Required: Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# Required: OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: custom invite link. If empty, the bot generates one automatically.
DISCORD_INVITE_URL=
