# Cakee settings. You do NOT need to copy this file yourself: on first run the
# bot creates .env from it and asks for the required values.
# Edit .env (not .env.example) to change settings, then restart the bot.
# Never commit the real .env file.

# =============================================================================
#  REQUIRED - the bot will not start without these
#  (If one is empty, the bot asks for it in the terminal and fills it in here.)
# =============================================================================

# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_BOT_TOKEN=

# OpenAI API key, starts with "sk-" (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# =============================================================================
#  OPTIONAL - safe to leave empty, the bot uses the default shown
# =============================================================================

# Which OpenAI model the AI chat uses.            Default: gpt-6-luna
# Change this when OpenAI retires a model (see https://platform.openai.com/docs/deprecations).
OPENAI_MODEL=

# Reply randomness, e.g. 0.7.                     Default: the model's own default
# Some models (like gpt-6-luna) only accept the default and will error if you set this.
OPENAI_TEMPERATURE=

# Tavily API key, starts with "tvly-" (free plan: about 1,000 searches a month, https://tavily.com).
# Lets the AI search the web for current info (weather, news...).   Default: empty = no web search
TAVILY_API_KEY=

# Custom link for !invite.                        Default: generated automatically
DISCORD_INVITE_URL=

# The web UI: a page on this computer to manage Cake's memory, AI channels, settings and logs.
# Only this computer can open it.                 Default: on. Write "off" to turn it off.
WEB_UI=

# The port of the web UI (http://localhost:PORT).  Default: 4567
WEB_UI_PORT=

# The web UI's secret. Leave it empty: the bot makes one on the first run and prints a link with it.
# Delete the value to get a new one (then open the new link from the terminal once).
WEB_UI_TOKEN=
